# Copy this to .streamlit/secrets.toml locally (never commit the real file),
# or paste the same keys into Streamlit Cloud → App settings → Secrets.

ENCRYPTION_KEY = "generate-with-python -c \"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())\""

# Optional: use a free hosted Postgres (Neon/Supabase) instead of local SQLite
# so state survives restarts and is shared with the GitHub Actions worker.
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"
